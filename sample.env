# Sage X3 ODBC Connection
# Copy this file to .env and fill in your values.
# See README.md for detailed instructions.

# --- Required ---
SAGE_SERVER=<your_host>\<your_instance>
SAGE_DATABASE=<your_database>
SAGE_USER=<your_user>
SAGE_PASSWORD=<your_password>

# --- Optional: Explicit port (recommended) ---
# Replace <your_port> with your actual SQL Server port
# Example: SAGE_PORT=1433
SAGE_PORT=<your_port>

# --- Optional: WSL2 Gateway ---
# If running from WSL2, set your Windows gateway IP here
# Requires netsh portproxy on Windows (see README.md)
# Example: SAGE_GATEWAY=172.x.x.1
SAGE_GATEWAY=<your_windows_gateway_ip>
